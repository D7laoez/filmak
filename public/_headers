# Global security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 0

# Static assets: browser + Cloudflare edge caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=3600
/ads.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=86400

# Public SEO/content pages: edge cache to absorb crawler bursts and repeat visits.
# These routes contain public movie-discovery content and are not personalized.
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
/discover
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
/about
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/privacy
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/faq
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
/tonight
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

# Public detail and taxonomy pages: short edge cache reduces repeated origin/server-function work.
/movie/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
/tv/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
/genre/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
